# ── Zulip platform (enabled when all three are set) ─────────────────────────
# ZULIP_SITE=https://myorg.zulipchat.com
# ZULIP_EMAIL=bot@myorg.zulipchat.com
# ZULIP_API_KEY=your_zulip_bot_api_key

# ── Slack platform (enabled when both are set) ──────────────────────────────
# Socket Mode app: bot token (xoxb-) + app-level token (xapp-)
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_APP_TOKEN=xapp-your-app-level-token

# ── Optional ────────────────────────────────────────────────────────────────
# PORT=3000
# ACCESS_FILE=./access.json

# Silent-summary LLM (only needed when silentSummary is enabled in access.json)
# SUMMARY_PROVIDER=gemini            # gemini | anthropic | openai | openrouter
# SUMMARY_MODEL=gemini-2.5-flash     # provider default when unset
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# OPENROUTER_API_KEY=...

# Verbose delivery tracing on stderr
# DEBUG_DELIVERY=1
