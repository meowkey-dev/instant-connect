{
  "name": "instant-connect",
  "version": "0.1.0",
  "description": "Unified chat-to-agent bridge: Zulip + Slack adapters over a platform-neutral core, delivering inbound messages via MCP notifications, terminal paste, or Herdr's native agent API",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "node scripts/bundle.mjs",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@slack/bolt": "^4.2.0",
    "express": "^5.2.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
